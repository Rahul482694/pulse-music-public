# Required: token for your own Discord bot. Never commit .env.
DISCORD_TOKEN=
# Required for the optional web controller: your Discord application ID.
CLIENT_ID=
# Optional: comma-separated Discord owner user IDs.
OWNER_IDS=
# Optional: register commands to one development server.
DEV_GUILD_ID=
# Optional web controller. Use an HTTPS origin and register /auth/callback in Discord.
WEB_BASE_URL=
DISCORD_CLIENT_SECRET=
# PORT=3000
# DATA_DIR=./data
# LAVALINK_NODES=[{"id":"mine","host":"lava.example.com","port":443,"authorization":"password","secure":true}]
